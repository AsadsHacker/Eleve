{
  "name": "eleve-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=eleve-frontend",
    "dev:backend": "npm run dev --workspace=eleve-backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npm run build --workspace=eleve-frontend",
    "build": "npm run build:frontend",
    "start": "npm run start --workspace=eleve-backend",
    "lint": "npm run lint --workspace=eleve-frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
